{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/oracle", "destination": "/api/oracle" },
    { "source": "/health", "destination": "/api/health" }
  ],
  "functions": {
    "api/oracle.py": { "maxDuration": 60 },
    "api/health.py": { "maxDuration": 30 }
  }
}
